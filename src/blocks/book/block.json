{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "endpaper/book",
	"version": "1.0.0",
	"title": "Book",
	"category": "embed",
	"icon": "book",
	"description": "Embed a book from Hardcover with its cover, description and rating.",
	"keywords": [ "hardcover", "reading", "endpaper" ],
	"textdomain": "endpaper",
	"styles": [
		{
			"name": "default",
			"label": "Plain",
			"isDefault": true
		}
	],
	"attributes": {
		"refreshedAt": {
			"type": "integer"
		},
		"bookId": {
			"type": "integer"
		},
		"bookUrl": {
			"type": "string"
		},
		"editionId": {
			"type": "integer"
		},
		"accentColor": {
			"type": "string"
		},
		"coverRadius": {
			"type": [ "string", "object" ]
		},
		"coverPosition": {
			"type": "string",
			"enum": [ "left", "right", "top" ],
			"default": "left"
		},
		"textAlign": {
			"type": "string",
			"enum": [ "left", "center", "right" ]
		},
		"coverSize": {
			"type": "string",
			"enum": [ "small", "medium", "large" ],
			"default": "medium"
		},
		"titleLevel": {
			"type": "integer",
			"default": 2
		},
		"showCover": {
			"type": "boolean",
			"default": true
		},
		"showAuthors": {
			"type": "boolean",
			"default": true
		},
		"showMeta": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"showUserRating": {
			"type": "boolean",
			"default": true
		},
		"showShelf": {
			"type": "boolean",
			"default": false
		},
		"showProgress": {
			"type": "boolean",
			"default": false
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		},
		"showReview": {
			"type": "boolean",
			"default": false
		},
		"reviewLength": {
			"type": "integer",
			"default": 300
		},
		"descriptionLength": {
			"type": "integer",
			"default": 160
		},
		"showCredit": {
			"type": "boolean",
			"default": false
		},
		"linkToHardcover": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"gradients": true,
			"link": true,
			"heading": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"shadow": true
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}

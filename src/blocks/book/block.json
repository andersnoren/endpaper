{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "endpaper/book",
	"version": "0.2.0",
	"title": "Book",
	"category": "embed",
	"icon": "book",
	"description": "Embed a book from Hardcover with its cover, description and rating.",
	"keywords": [ "hardcover", "reading", "endpaper" ],
	"textdomain": "endpaper",
	"attributes": {
		"bookId": {
			"type": "integer"
		},
		"accentColor": {
			"type": "string"
		},
		"coverRadius": {
			"type": [ "string", "object" ]
		},
		"titleLevel": {
			"type": "integer",
			"default": 2
		},
		"showCover": {
			"type": "boolean",
			"default": true
		},
		"showAuthors": {
			"type": "boolean",
			"default": true
		},
		"showMeta": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"showShelf": {
			"type": "boolean",
			"default": false
		},
		"showProgress": {
			"type": "boolean",
			"default": false
		},
		"showDescription": {
			"type": "boolean",
			"default": true
		},
		"descriptionLength": {
			"type": "integer",
			"default": 280
		},
		"showLink": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"gradients": true,
			"link": true,
			"heading": true,
			"__experimentalSkipSerialization": [ "background", "gradients" ],
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalSkipSerialization": [ "padding" ]
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"shadow": {
			"__experimentalSkipSerialization": true
		}
	},
	"selectors": {
		"root": ".wp-block-endpaper-book",
		"border": ".wp-block-endpaper-book .endpaper-book__card",
		"shadow": ".wp-block-endpaper-book .endpaper-book__card",
		"color": {
			"background": ".wp-block-endpaper-book .endpaper-book__card"
		},
		"spacing": {
			"padding": ".wp-block-endpaper-book .endpaper-book__card"
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}

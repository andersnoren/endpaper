{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "endpaper/reading-list",
	"version": "0.2.0",
	"title": "Reading List",
	"category": "widgets",
	"icon": "book-alt",
	"description": "Show books from your Hardcover library, such as the ones you are currently reading.",
	"keywords": [ "hardcover", "books", "currently reading", "endpaper" ],
	"textdomain": "endpaper",
	"attributes": {
		"status": {
			"type": "integer",
			"default": 2
		},
		"count": {
			"type": "integer",
			"default": 5
		},
		"layout": {
			"type": "string",
			"enum": [ "list", "grid" ],
			"default": "list"
		},
		"accentColor": {
			"type": "string"
		},
		"coverRadius": {
			"type": [ "string", "object" ]
		},
		"titleLevel": {
			"type": "integer",
			"default": 0
		},
		"showCover": {
			"type": "boolean",
			"default": true
		},
		"showAuthors": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"showProgress": {
			"type": "boolean",
			"default": true
		},
		"linkToHardcover": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"gradients": true,
			"link": true,
			"heading": true,
			"__experimentalSkipSerialization": [ "background", "gradients" ],
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true,
			"__experimentalSkipSerialization": [ "padding" ],
			"__experimentalDefaultControls": {
				"blockGap": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"shadow": {
			"__experimentalSkipSerialization": true
		}
	},
	"selectors": {
		"root": ".wp-block-endpaper-reading-list",
		"border": ".wp-block-endpaper-reading-list .endpaper-reading-list__card",
		"shadow": ".wp-block-endpaper-reading-list .endpaper-reading-list__card",
		"color": {
			"background": ".wp-block-endpaper-reading-list .endpaper-reading-list__card"
		},
		"spacing": {
			"padding": ".wp-block-endpaper-reading-list .endpaper-reading-list__card"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}

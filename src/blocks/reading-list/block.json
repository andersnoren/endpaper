{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "endpaper/reading-list",
	"version": "0.1.0",
	"title": "Reading List",
	"category": "widgets",
	"icon": "book-alt",
	"description": "Show books from your Hardcover library, such as the ones you are currently reading.",
	"keywords": [ "hardcover", "books", "currently reading", "endpaper" ],
	"textdomain": "endpaper",
	"attributes": {
		"status": {
			"type": "integer",
			"default": 2
		},
		"count": {
			"type": "integer",
			"default": 5
		},
		"layout": {
			"type": "string",
			"enum": [ "list", "grid" ],
			"default": "list"
		},
		"showCover": {
			"type": "boolean",
			"default": true
		},
		"showAuthors": {
			"type": "boolean",
			"default": true
		},
		"showRating": {
			"type": "boolean",
			"default": true
		},
		"showProgress": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}

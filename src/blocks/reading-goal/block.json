{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "endpaper/reading-goal",
	"version": "1.0.0",
	"title": "Reading Goal",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Show how far along you are on one of your reading goals on Hardcover.",
	"keywords": [
		"hardcover",
		"reading goal",
		"challenge",
		"progress",
		"endpaper"
	],
	"textdomain": "endpaper",
	"styles": [
		{
			"name": "gauge",
			"label": "Gauge",
			"isDefault": true
		},
		{
			"name": "bar",
			"label": "Bar"
		}
	],
	"attributes": {
		"refreshedAt": {
			"type": "integer"
		},
		"goalId": {
			"type": "integer",
			"default": 0
		},
		"accentColor": {
			"type": "string"
		},
		"titleLevel": {
			"type": "integer",
			"default": 2
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		},
		"showDays": {
			"type": "boolean",
			"default": true
		},
		"showPercent": {
			"type": "boolean",
			"default": false
		},
		"showCredit": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"gradients": true,
			"link": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": {
				"radius": true,
				"color": true,
				"width": true,
				"style": true
			}
		},
		"shadow": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}

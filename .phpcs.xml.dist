<?xml version="1.0"?>
<ruleset name="Endpaper">
	<description>Coding standards for the Endpaper plugin.</description>

	<!-- Check all PHP files in the plugin, except generated and third-party code. -->
	<file>.</file>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- The oldest WordPress version the plugin supports. -->
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress-Extra"/>

	<!-- Everything in the global namespace must start with the plugin prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="endpaper"/>
			</property>
		</properties>
	</rule>

	<!-- All translatable strings must use the plugin text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="endpaper"/>
			</property>
		</properties>
	</rule>
</ruleset>
